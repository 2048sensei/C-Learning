root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4

[*.mjs]
indent_style = space
indent_size = 2

# 站点页面是构建产物，逐字节参与 SHA-256 校验。
# 编辑后请运行 scripts/update-release-info.ps1 重算清单。
# 这里不指定 end_of_line，避免保存时改动换行符导致校验失败。
[学习资源/**]
insert_final_newline = false
trim_trailing_whitespace = false
